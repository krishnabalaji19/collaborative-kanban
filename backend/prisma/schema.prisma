generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ORG_ADMIN
  TENANT_ADMIN
  MEMBER
}

model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  tenants     Tenant[]
  memberships Membership[]

  @@map("organizations")
}

model Tenant {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  boards         Board[]
  activityLogs   ActivityLog[]

  // lets child tables use a composite FK (id + organization)
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("tenants")
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  email        String       @unique
  passwordHash String       @map("password_hash")
  createdAt    DateTime     @default(now()) @map("created_at")
  memberships  Membership[]
  tasks        Task[]       @relation("AssignedTasks")

  @@map("users")
}

// tenantId = null means organization-level membership (Org Admin)
model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  tenantId       String?      @map("tenant_id") @db.Uuid
  role           Role
  createdAt      DateTime     @default(now()) @map("created_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant         Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@map("memberships")
}

model Board {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  name           String
  description    String?
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  tenant         Tenant   @relation(fields: [tenantId, organizationId], references: [id, organizationId], onDelete: Cascade)
  columns        Column[]
  tasks          Task[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("boards")
}

model Column {
  id        String @id @default(uuid()) @db.Uuid
  boardId   String @map("board_id") @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  name      String
  position  Float
  board     Board  @relation(fields: [boardId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tasks     Task[]

  @@unique([id, tenantId])
  @@index([boardId, position])
  @@map("columns")
}

model Task {
  id          String   @id @default(uuid()) @db.Uuid
  boardId     String   @map("board_id") @db.Uuid
  columnId    String   @map("column_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  title       String
  description String?
  priority    String   @default("MEDIUM")
  dueDate     DateTime? @map("due_date")
  assignedTo  String?  @map("assigned_to") @db.Uuid
  // fractional ordering: new position = midpoint of neighbours
  position    Float
  // optimistic locking: increment on every update
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  board       Board    @relation(fields: [boardId, tenantId], references: [id, tenantId], onDelete: Cascade)
  column      Column   @relation(fields: [columnId, tenantId], references: [id, tenantId], onDelete: Cascade)
  assignee    User?    @relation("AssignedTasks", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([columnId, position])
  @@map("tasks")
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  action     String
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("activity_logs")
}
